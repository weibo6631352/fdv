# 复制本文件为 `.env` 后再填写。
#
# 这份示例默认按“安全模式 / 本地联调”来写，而不是默认直接进入实盘：
# 1. 当前仓库没有正式的 dry-run / paper trading 开关；设计文档也明确写了“不提供 dry-run / paper trading 模式”。
# 2. 如果 `WALLET_PRIVATE_KEY` 留空，runtime 会退回内存模拟执行器，但 supervisor 会把自动下单闸门保持为关闭。
#    这适合本地验证配置、数据库、Admin API、WS 和运行状态，不等于真正的交易所沙盒。
# 3. 要进入实盘，至少需要同时满足：
#    - `WALLET_PRIVATE_KEY` 已配置；
#    - `PORTFOLIO_BUDGET_USDC`、`MAX_ORDER_USDC`、`MAX_MARKET_USDC`、`MAX_TOTAL_USDC`、`MAX_OPEN_ORDERS` 都大于 0；
#    - 数据库、Market WS、User WS、reconcile 都健康；
#    - 启动后 `/ready` 返回 `ready_to_trade=true`，且 `/runtime` 的 phase 为 `trading_enabled`。
# 4. 推荐的资金上限关系：
#    `MAX_ORDER_USDC <= MAX_MARKET_USDC <= MAX_TOTAL_USDC <= PORTFOLIO_BUDGET_USDC`
#
# 实盘配置思路：
# - 填写下面所有必需密钥和数据库信息。
# - 把预算和风控上限改成符合你真实风险承受能力的正数。
# - 策略本身的业务参数请直接改 `src/polymarket_trader/strategies/current/` 里的 Python 文件，不再通过 `.env` 注入。
#
# 虚拟 / 安全模式配置思路：
# - 保持 `WALLET_PRIVATE_KEY=` 为空。
# - 下面示例已经把关键资金上限设成了 `0`，这样即使误填了别的字段，也不会通过自动交易就绪校验。
# - 可以继续填写数据库、接口地址，启动服务后观察 `/health`、`/ready`、`/runtime`，但不会自动实盘下单。


# =========================
# Polymarket 地址与签名形态
# =========================

# `POLYMARKET_CLOB_HOST`
# CLOB REST 基地址。
# 代码会用它读取 orderbook，也会把签名后的订单提交到这里。
# 正常生产环境保持官方地址；只有在你前面有自建网关、代理层或录制回放环境时才覆盖。
POLYMARKET_CLOB_HOST=https://clob.polymarket.com

# `POLYMARKET_GAMMA_HOST`
# Gamma API 基地址。
# 主要用于 market discovery，也就是扫描 Polymarket 上的新 market / event，并交给当前策略做 universe 选择。
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com

# `POLYMARKET_DATA_HOST`
# Data API 基地址。
# 主要给 reconcile 和账户快照用，例如 positions、trades 等权威数据拉取。
POLYMARKET_DATA_HOST=https://data-api.polymarket.com

# `POLYMARKET_MARKET_WS`
# 市场侧 WebSocket 地址。
# 用来接收盘口、价格触发和 market 相关实时事件；如果这个地址连不上，自动交易不会进入 ready。
POLYMARKET_MARKET_WS=wss://ws-subscriptions-clob.polymarket.com/ws/market

# `POLYMARKET_USER_WS`
# 用户侧 WebSocket 地址。
# 用来接收自己的 order / fill / trade 状态更新；如果断开且未完成恢复，系统不会允许继续自动买入。
POLYMARKET_USER_WS=wss://ws-subscriptions-clob.polymarket.com/ws/user

# `POLYMARKET_CHAIN_ID`
# 交易签名所在链的 chain id。
# 当前 Polymarket 主网默认走 Polygon，因此这里通常是 `137`；填错会导致签名或请求头派生异常。
POLYMARKET_CHAIN_ID=137

# `POLYMARKET_SIGNATURE_TYPE`
# 官方客户端签名模式：
# - `0` = EOA，普通钱包，默认也是最常见配置；
# - `1` = proxy；
# - `2` = safe。
# 如果你不是明确知道自己在用代理钱包 / Safe，就保持 `0`。
POLYMARKET_SIGNATURE_TYPE=0

# `POLYMARKET_FUNDER_ADDRESS`
# 只有当 `POLYMARKET_SIGNATURE_TYPE` 是 `1` 或 `2` 时才需要填写。
# 这是代理钱包 / Safe 模式下的 funder 地址；EOA 模式留空即可。
POLYMARKET_FUNDER_ADDRESS=


# ==================
# 预算与框架风控阈值
# ==================

# `PORTFOLIO_BUDGET_USDC`
# 组合总预算上限，单位是 USDC。
# 策略分配器会把这个预算在 eligible markets 之间尽量等权分配。
# 这里示例写 `0`，表示“不要进入自动交易”；实盘必须改成大于 0 的数。
PORTFOLIO_BUDGET_USDC=0

# `MAX_ORDER_USDC`
# 单笔 BUY 允许投入的最大金额，单位是 USDC。
# Risk Manager 会在真正下单前检查这道硬门禁；实盘必须大于 0，并且通常不应大于 `MAX_MARKET_USDC`。
MAX_ORDER_USDC=0

# `MAX_MARKET_USDC`
# 单个 market 的总风险暴露上限，单位是 USDC。
# 会把该 market 已有持仓、未完成订单和本次新增下单一起算进去；实盘必须大于 0。
MAX_MARKET_USDC=0

# `MAX_TOTAL_USDC`
# 全账户总风险暴露上限，单位是 USDC。
# 用于限制所有 market 合计的在场资金，避免等权分配在 market 很多时把总仓位放得过大；实盘必须大于 0。
MAX_TOTAL_USDC=0

# `MARKET_SYNC_INTERVAL_SECONDS`
# 周期任务间隔，单位是秒。
# 目前同时影响：
# - market discovery 扫描周期；
# - 周期性 reconcile 周期；
# - supervisor 判断 reconcile 是否“过旧”的阈值（大致是 `max(该值 * 2, 60)` 秒）。
# 改太小会增加外部请求压力，改太大则会让恢复和发现新 market 变慢。
MARKET_SYNC_INTERVAL_SECONDS=60

# `ORDER_RETRY_LIMIT`
# 同一个下单意图允许的最大重试次数。
# Risk Manager 会用它限制异常 market 或异常网络下的重复尝试，避免在同一个问题上持续消耗配额和风控预算。
ORDER_RETRY_LIMIT=2

# `MAX_OPEN_ORDERS`
# 账户允许同时存在的未完成订单数量上限。
# 达到这个上限后，新订单会被风控拒绝；实盘必须大于 0。
# 这里示例设成 `0`，是为了让复制后的配置默认保持安全模式。
MAX_OPEN_ORDERS=0


# =====================
# 性能隔离、队列与超时
# =====================

# `ENABLE_UVLOOP`
# 是否在运行时尝试安装 uvloop。
# 这是运行时性能优化项，不改交易规则；如果本机没装 uvloop，代码会静默回退到默认 asyncio 事件循环。
ENABLE_UVLOOP=true

# `TRADING_EVENT_QUEUE_MAX_SIZE`
# P0 交易队列容量。
# entry signal、订单状态等高优先级事件会先进这条队列；太小容易提早触发背压，太大则可能掩盖真实延迟问题。
TRADING_EVENT_QUEUE_MAX_SIZE=1000

# `MAINTENANCE_EVENT_QUEUE_MAX_SIZE`
# P2 维护队列容量。
# 低优先级任务会走这里；当 P0 压力上来时，supervisor 允许暂停这类任务，避免抢占交易热路径资源。
MAINTENANCE_EVENT_QUEUE_MAX_SIZE=1000

# `PERSISTENCE_EVENT_QUEUE_MAX_SIZE`
# P3 持久化队列容量，同时也会作为本地 outbox 的最大积压量。
# 如果这里积压太高，readiness 会被标记为不健康，提示“审计/落库已经追不上当前系统速度”。
PERSISTENCE_EVENT_QUEUE_MAX_SIZE=5000

# `TRADING_WORKER_THREADS`
# 交易专用线程池大小。
# 订单签名、同步 SDK 调用和阻塞型交易操作都走这里；不要盲目调太大，否则可能放大上下文切换和外部限流问题。
TRADING_WORKER_THREADS=4

# `MAINTENANCE_WORKER_THREADS`
# 维护任务线程池大小。
# 给 market discovery、管理面或其他非 P0 工作使用，目的是和交易线程池隔离，避免慢任务拖慢下单链路。
MAINTENANCE_WORKER_THREADS=4

# `MAINTENANCE_PROCESS_WORKERS`
# 维护任务进程池大小。
# 预留给更重的 CPU 型维护工作，和交易线程池隔离；一般保持默认即可。
MAINTENANCE_PROCESS_WORKERS=2

# `ORDER_SUBMIT_TIMEOUT_MS`
# 订单提交超时，单位毫秒。
# submit / cancel / replace 默认都会参考这个值；超过后执行器会返回超时结果，而不是无限等待外部接口。
ORDER_SUBMIT_TIMEOUT_MS=3000

# `ORDER_SIGN_TIMEOUT_MS`
# 订单签名超时，单位毫秒。
# 如果官方客户端签名、L2 凭证派生或本地签名过程卡住，会在这个时间后超时返回。
ORDER_SIGN_TIMEOUT_MS=1000

# `CRITICAL_LOCK_TIMEOUT_MS`
# 交易执行器关键锁等待上限，单位毫秒。
# 这把锁保护幂等和关键状态；超时后系统宁愿快速失败，也不允许热路径一直排队等待。
CRITICAL_LOCK_TIMEOUT_MS=20

# `TRADING_QUEUE_WARN_DEPTH`
# P0 交易队列告警阈值。
# 当 `trading_queue_depth` 达到这个值时，supervisor 会优先暂停低优先级任务，给交易热路径让路。
TRADING_QUEUE_WARN_DEPTH=100

# `ENTRY_SIGNAL_TO_SUBMIT_WARN_MS`
# 从“价格触发”到“真正开始提交订单”的告警阈值，单位毫秒。
# supervisor 也会用它一起判断系统是否进入 P0 背压状态。
ENTRY_SIGNAL_TO_SUBMIT_WARN_MS=500


# ==========
# 数据库连接
# ==========

# `DATABASE_URL`
# 完整数据库连接串；如果填了它，下面的拆分字段会被忽略。
# 例子：`postgresql+asyncpg://trader:password@127.0.0.1:5432/trader`
# 生产环境通常通过安全注入方式提供，不建议把真值写进仓库。
DATABASE_URL=

# `DATABASE_DRIVER`
# 当 `DATABASE_URL` 为空时，用这个驱动名拼接连接串。
# 当前默认是 `postgresql+asyncpg`，对应异步 PostgreSQL 驱动。
DATABASE_DRIVER=postgresql+asyncpg

# `DATABASE_HOST`
# PostgreSQL 主机名或 IP。
# 本地开发通常是 `localhost` 或 `127.0.0.1`；容器部署时改成对应服务名。
DATABASE_HOST=localhost

# `DATABASE_PORT`
# PostgreSQL 端口。
# 默认是 `5432`。
DATABASE_PORT=5432

# `DATABASE_NAME`
# 数据库名。
# 调用 `polymarket_trader.infra.db.initialize_database` 会按当前源码模型在这个库里建表。
DATABASE_NAME=trader

# `DATABASE_USER`
# 数据库用户名。
DATABASE_USER=trader

# `DATABASE_PASSWORD`
# 数据库密码。
# 示例里必须留空；本地开发可以在复制出的 `.env` 中填写，生产环境请通过 secret manager 或部署平台注入。
DATABASE_PASSWORD=


# ==========
# 敏感密钥区
# ==========

# `POLYMARKET_API_KEY`
# Polymarket L2 API key。
# 这三个 API 凭证要么一起填，要么三个都留空。
# 如果都留空，但 `WALLET_PRIVATE_KEY` 已配置，运行时会尝试通过官方客户端创建或派生。
POLYMARKET_API_KEY=

# `POLYMARKET_API_SECRET`
# Polymarket L2 API secret。
# 不能单独填写，必须和 `POLYMARKET_API_KEY`、`POLYMARKET_API_PASSPHRASE` 一起成组出现。
POLYMARKET_API_SECRET=

# `POLYMARKET_API_PASSPHRASE`
# Polymarket L2 API passphrase。
# 同上，必须三项同时存在或同时为空。
POLYMARKET_API_PASSPHRASE=

# `WALLET_PRIVATE_KEY`
# 实盘最关键的私钥配置。
# 这是创建交易客户端、生成地址、签名订单和通过启动就绪校验的硬条件。
# 留空 = 安全模式 / 本地联调；填上 = 允许系统继续朝“可实盘”方向检查。
WALLET_PRIVATE_KEY=

# `SIGNER_PRIVATE_KEY`
# 可选的独立 signer 私钥。
# 如果你的签名钥和资金钱包钥是同一把，就留空；代码会自动回退为使用 `WALLET_PRIVATE_KEY`。
SIGNER_PRIVATE_KEY=

# `BUILDER_ATTRIBUTION_CREDENTIALS`
# 预留的 builder attribution 凭证。
# 当前仓库里只做了配置位和脱敏处理，业务逻辑尚未实际消费；没有明确接入需求时保持空即可。
BUILDER_ATTRIBUTION_CREDENTIALS=
