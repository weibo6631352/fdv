# Polymarket 端点配置：这里只放地址，不放任何密钥。
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_DATA_HOST=https://data-api.polymarket.com
POLYMARKET_MARKET_WS=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_USER_WS=wss://ws-subscriptions-clob.polymarket.com/ws/user

# 策略与风控：默认值偏保守，0 通常表示“还没有准备好自动交易”。
PORTFOLIO_BUDGET_USDC=100
MAX_ORDER_USDC=10
MAX_MARKET_USDC=20
MAX_TOTAL_USDC=100
ENTRY_NO_PRICE_MAX=0.60
EXIT_NO_PRICE=0.70
MIN_LIQUIDITY_USDC=5
MAX_SPREAD=0.10
MARKET_SYNC_INTERVAL_SECONDS=60
ORDER_RETRY_LIMIT=2
MAX_OPEN_ORDERS=50

# 性能与优先级：队列、线程池和超时都必须有限，避免热路径被慢任务拖住。
ENABLE_UVLOOP=true
TRADING_EVENT_QUEUE_MAX_SIZE=1000
MAINTENANCE_EVENT_QUEUE_MAX_SIZE=1000
PERSISTENCE_EVENT_QUEUE_MAX_SIZE=5000
TRADING_WORKER_THREADS=4
MAINTENANCE_WORKER_THREADS=4
MAINTENANCE_PROCESS_WORKERS=2
ORDER_SUBMIT_TIMEOUT_MS=3000
ORDER_SIGN_TIMEOUT_MS=1000
CRITICAL_LOCK_TIMEOUT_MS=20
TRADING_QUEUE_WARN_DEPTH=100
ENTRY_SIGNAL_TO_SUBMIT_WARN_MS=500

# 数据库：完整连接串可以由安全环境注入；这里拆分字段示例，数据库密码必须留空。
DATABASE_URL=
DATABASE_DRIVER=postgresql+asyncpg
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fdv
DATABASE_USER=fdv
DATABASE_PASSWORD=

# 密钥类配置：真值不能写进仓库，启动阶段缺失时也必须禁止自动下单。
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
WALLET_PRIVATE_KEY=
SIGNER_PRIVATE_KEY=
BUILDER_ATTRIBUTION_CREDENTIALS=
